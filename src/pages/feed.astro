---
// /feed/ — dated updates, newest first, from src/content/feed/. Also served as /rss.xml.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('feed')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const rendered = await Promise.all(entries.map(async (e) => ({ e, Content: (await render(e)).Content })));
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="Feed" description="What Léonard Tschora shipped lately: new apps, new versions and what was learned, newest first.">
  <div class="prose">
    <h1>Feed</h1>
    <p class="lead">
      What I shipped lately, newest first. Also as <a href="/rss.xml">RSS</a>.
    </p>

    {rendered.map(({ e, Content }) => (
      <article class="feed-entry" id={e.id}>
        <time class="feed-date" datetime={e.data.date.toISOString().slice(0, 10)}>{fmt(e.data.date)}</time>
        <h2><a href={`#${e.id}`}>{e.data.title}</a></h2>
        <Content />
        {e.data.link && (
          <p class="feed-link">
            <a class="button" href={e.data.link} target="_blank" rel="noopener">{e.data.linkLabel}</a>
          </p>
        )}
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  .feed-entry {
    border-top: 1px solid var(--border);
    padding: 1.4rem 0 0.4rem;
    scroll-margin-top: 5rem;
  }
  .feed-date {
    font-size: 0.82rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .feed-entry h2 { margin: 0.2rem 0 0.6rem; font-size: clamp(1.15rem, 2.4vw, 1.35rem); }
  .feed-entry h2 a { color: inherit; text-decoration: none; }
  .feed-entry h2 a:hover { color: var(--accent); text-decoration: underline; }
  .feed-link .button { font-size: 0.93rem; padding: 0.45rem 0.95rem; }
</style>
