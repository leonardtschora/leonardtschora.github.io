---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout>
  <section class="hero">
    <img
      class="avatar"
      src={SITE.avatar}
      alt={`Portrait of ${SITE.name}`}
      width="160"
      height="160"
      loading="eager"
    />
    <div class="hero-text">
      <h1>{SITE.name}</h1>
      <p class="tagline">{SITE.tagline}</p>
      <p class="meta">{SITE.employer} · {SITE.location}</p>
      <div class="cta">
        <a class="button" href={SITE.resume} target="_blank" rel="noopener">
          ↓ Download résumé
        </a>
        <a class="button secondary" href="/thesis/">View thesis &amp; publications</a>
      </div>
    </div>
  </section>

  <section class="intro prose">
    <h2>About</h2>
    <p>
      I hold a Ph.D. in Computer Science and work as a Machine Learning engineer
      focused on electricity price forecasting and energy-market analytics. My
      research benchmarks state-of-the-art machine-learning methods on European
      day-ahead electricity markets and explores differentiable-optimization and
      explainability approaches to price prediction.
    </p>
    <p>
      Read about my <a href="/thesis/">Ph.D. thesis and publications</a>, or see
      my <a href="/experience/">experience</a>, <a href="/education/">education</a>,
      and <a href="/portfolio/">selected projects</a>.
    </p>
  </section>

  <style>
    .hero {
      display: flex;
      gap: 1.75rem;
      align-items: center;
      flex-wrap: wrap;
      margin-block: 1rem 2.5rem;
    }
    .avatar {
      width: 160px;
      height: 160px;
      border-radius: 50%;
      object-fit: cover;
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
    }
    .hero-text { flex: 1 1 18rem; }
    .hero h1 { margin-top: 0; }
    .tagline {
      font-size: 1.15rem;
      color: var(--text);
      margin-bottom: 0.5rem;
    }
    .meta { color: var(--text-muted); margin-bottom: 1.25rem; }
    .cta { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  </style>
</BaseLayout>
